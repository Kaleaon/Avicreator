{
  "name": "lizard",
  "params": {
    "body_length": {"value": 0.9, "min": 0.5, "max": 1.5},
    "tail_length": {"value": 1.1, "min": 0.4, "max": 2.0},
    "tail_curl": {"value": -20, "min": -90, "max": 90},
    "leg_length": {"value": 0.28, "min": 0.15, "max": 0.5}
  },
  "parts": [
    {"kind": "chain", "name": "spine", "from": [0, "$leg_length+0.1", "-$body_length*0.5"], "dir": [0, 0, 1], "length": "$body_length", "segments": 3, "radius": [0.13, 0.15, 0.11]},
    {"kind": "chain", "name": "neck", "attach": "spine", "dir": [0, 0.35, 1], "length": 0.18, "radius": [0.09, 0.075]},
    {"kind": "blob", "name": "head", "attach": "neck", "offset": [0, 0, 0.1], "axis": [0, -0.1, 1], "radii": [0.085, 0.065, 0.16]},
    {"kind": "chain", "name": "tail", "attach": "spine.0", "at": 0, "dir": [0, -0.1, -1], "length": "$tail_length", "segments": 6, "curl": "$tail_curl", "bend_axis": [0, 1, 0], "radius": [0.11, 0.015]},
    {"kind": "chain", "name": "front_leg", "mirror": true, "attach": "spine.2", "at": 0.5, "offset": [0.1, -0.03, 0], "points": [[0.16, -0.04, 0.02], [0.2, "-$leg_length-0.05", 0.08]], "radius": [0.05, 0.035, 0.03]},
    {"kind": "chain", "name": "back_leg", "mirror": true, "attach": "spine.0", "at": 0.4, "offset": [0.11, -0.03, 0], "points": [[0.17, -0.04, -0.04], [0.22, "-$leg_length-0.05", 0.04]], "radius": [0.06, 0.04, 0.03]}
  ]
}
